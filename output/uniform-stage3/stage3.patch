+    @contextmanager
+    def _training_slot(self):
+        slot = _TrainingLock(self.candidates_root)
+        if not slot.acquire():
+            raise RuntimeError('Training or evaluation is already using the candidate slot')
+        try:
+            yield
+        finally:
+            slot.release()
