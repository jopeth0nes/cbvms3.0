+        from core.trainer import _letterbox
+        image = cv2.cvtColor(_letterbox(bgr,224),cv2.COLOR_BGR2RGB).astype(np.float32)/255.
+        tensor = self.torch.from_numpy(image.transpose(2,0,1).copy()).unsqueeze(0)
