+class _EvaluationLock:
+    def __init__(self, root: Path):
+        self.path = root / ".evaluation.lock"
+        with _ROOT_GUARD:
+            self.thread_lock = _ROOT_LOCKS.setdefault(str(root.resolve()), threading.Lock())
+        self.stream = None
+
+    def acquire(self) -> bool:
+        if not self.thread_lock.acquire(blocking=False):
+            return False
+        try:
+            if self.path.is_symlink():
+                raise ValueError("Evaluation lock cannot be a symlink")
+            flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
+            descriptor = os.open(self.path, flags, 0o600)
+            self.stream = os.fdopen(descriptor, "a+")
+            try:
+                fcntl.flock(self.stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError:
+                self.stream.close()
+                self.stream = None
+                self.thread_lock.release()
+                return False
+            return True
+        except Exception:
+            if self.stream:
+                self.stream.close()
+                self.stream = None
+            self.thread_lock.release()
+            raise
+
+    def release(self) -> None:
+        if self.stream:
+            try:
+                fcntl.flock(self.stream.fileno(), fcntl.LOCK_UN)
+            finally:
+                self.stream.close()
+                self.stream = None
+                self.thread_lock.release()
+
