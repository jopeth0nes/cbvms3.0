+        last = None
+        last_times = dict(preview=0., tracking=0., assessment=0.)
+        next_render, next_stats = start, origin[0]
+        process.cpu_percent()
+        def tick():
+            nonlocal last, next_render, next_stats
+            now = time.monotonic()
