+"""Same-input handoff/empty-scene probes and a sustained synthetic preview run.
+
+These isolate orchestration costs; they do not measure model accuracy or physical
+camera performance. The empty scene uses real SQLite in a temporary directory.
+"""
+from dataclasses import replace
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from types import ModuleType, SimpleNamespace
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from core import live_pipeline as current
+from core.live_state import FrameContext
+from database.db_manager import CBVMSDatabase
+
+
+def load_baseline(ref):
+    module = ModuleType("monitor_pipeline_baseline")
+    sys.modules[module.__name__] = module
+    source = subprocess.check_output(["git", "show", f"{ref}:core/live_pipeline.py"], cwd=ROOT, text=True)
+    exec(compile(source, "baseline_live_pipeline", "exec"), module.__dict__)
+    return module
+
+
+def summary(samples):
+    return {"n": len(samples), "p50_ms": round(float(np.percentile(samples, 50)), 4),
+            "p95_ms": round(float(np.percentile(samples, 95)), 4)}
+
+
+def probe(module, policy, db, iterations):
+    frame = np.zeros((720, 1280, 3), np.uint8)
+    task = module.MonitorTask(FrameContext(1, ("synthetic", 0), time.monotonic()),
+                              frame, time.time(), threading.Event())
+    handoffs = []
+    for _ in range(iterations):
+        started = time.perf_counter()
+        value = replace(task, observations=()) if policy == "baseline" else task.with_observations(())
+        handoffs.append((time.perf_counter()-started)*1000)
+    shared_pixels = value.frame is task.frame
+    processor = module.LiveProcessor(db, SimpleNamespace(recognize_faces=lambda *a, **k: [], last_error=None),
+        None, SimpleNamespace(is_trained=lambda _: False), None, None)
+    costs = []
+    for index in range(iterations):
+        task = module.MonitorTask(FrameContext(1, ("synthetic", index), time.monotonic()),
+                                  frame, time.time(), threading.Event())
+        started = time.perf_counter()
+        result = processor.analyze(task)
+        costs.append((time.perf_counter()-started)*1000)
+        assert result is not None and not result.assessments
+    return {"policy": policy, "handoff": summary(handoffs), "handoff_shares_owned_pixels": shared_pixels,
+            "empty_scene_analysis": summary(costs), "resolution": [1280, 720]}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline-ref", default="244d6805ee00c5f8b3bf60f9fecf0d288dc70b7c")
+    parser.add_argument("--runs", type=int, default=3)
+    parser.add_argument("--iterations", type=int, default=500)
+    parser.add_argument("--sustained-seconds", type=float, default=60.)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if args.runs < 1 or args.iterations < 1 or args.sustained_seconds <= 0:
+        parser.error("runs, iterations and sustained-seconds must be positive")
+    baseline = load_baseline(args.baseline_ref)
+    runs = []
+    with tempfile.TemporaryDirectory(prefix="cbvms_monitor_benchmark_") as folder:
+        db = CBVMSDatabase(Path(folder)/"disposable.db")
+        db.initialize(process_deadlines=False)
+        for run in range(args.runs):
+            # Alternate order to limit warm-cache/order bias.
+            conditions = [(baseline, "baseline"), (current, "candidate")]
+            if run % 2:
+                conditions.reverse()
+            for module, policy in conditions:
+                result = probe(module, policy, db, args.iterations)
+                runs.append(result)
+                print(json.dumps(result), flush=True)
+    import psutil
+    import cv2
+    from core.performance import PERF
+    from scripts.benchmark_live_monitor import run as preview
+    PERF.enabled = True
+    cv2.setNumThreads(2)  # Same preview policy as the application.
+    process = psutil.Process()
+    memory = []
+    stop_sampling = threading.Event()
+    def sample_memory():
+        while not stop_sampling.wait(1):
+            memory.append(round(process.memory_info().rss/2**20, 2))
+    sampler = threading.Thread(target=sample_memory, daemon=True)
+    sampler.start()
+    rss_before = process.memory_info().rss/2**20
+    cpu_before = process.cpu_times()
+    try:
+        sustained = preview(args.sustained_seconds, 5, True, "after", (None, None, None), 200)
+    finally:
+        stop_sampling.set()
+        sampler.join(2)
+    cpu_after = process.cpu_times()
+    sustained.update(rss_before_mb=round(rss_before, 2), rss_after_mb=round(process.memory_info().rss/2**20, 2),
+        cpu_percent_one_core=round(100*((cpu_after.user-cpu_before.user)+(cpu_after.system-cpu_before.system))/sustained["elapsed_seconds"], 2),
+        rss_sampled_mb=memory,
+        bounded_timings=PERF.snapshot())
+    results = {"kind": "controlled_synthetic_no_camera", "baseline_ref": args.baseline_ref,
+               "accuracy_evaluated": False, "comparisons": runs, "sustained_preview": sustained}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(results, indent=2)+"\n")
+    print(json.dumps(sustained), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/benchmark_monitor_startup.py b/scripts/benchmark_monitor_startup.py
new file mode 100644
index 0000000..2a7756d
--- /dev/null
+++ b/scripts/benchmark_monitor_startup.py
@@ -0,0 +1,174 @@
+"""Paired, fresh-process local-model probe, using synthetic pixels and no database.
+
+The login delay is controlled, not a measurement of a human login or native UI.
+Application-cold means a new Python process; filesystem caches are NOT flushed.
+No camera, student data, business writes, downloads, or accuracy claims.
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+
+def baseline_registry(recognizer, detector, trainer, matcher, ref):
+    import types
+    import numpy as np
+    module = types.ModuleType("benchmark_baseline_readiness")
+    sys.modules[module.__name__] = module
+    source = subprocess.check_output(["git", "show", f"{ref}:core/model_readiness.py"], cwd=ROOT, text=True)
+    exec(compile(source, "baseline_readiness", "exec"), module.__dict__)
+    registry = module.face_readiness(recognizer)
+    source = subprocess.check_output(["git", "show", f"{ref}:ui/dashboard.py"], cwd=ROOT, text=True)
+    cls = next(n for n in ast.parse(source).body if isinstance(n, ast.ClassDef) and n.name == "CBVMSDashboard")
+    method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "_prewarm_models")
+    namespace = {"np": np}
+    exec(compile(ast.fix_missing_locations(ast.Module(body=[method], type_ignores=[])), "baseline_dashboard", "exec"), namespace)
+    owner = types.SimpleNamespace(_readiness=registry, _person_detector=detector,
+                                  _trainer=trainer, _uniform_matcher=matcher)
+    return registry, lambda: namespace["_prewarm_models"](owner)
+
+
+def child(args):
+    started = time.monotonic()
+    import importlib.metadata
+    import platform
+    import resource
+    from types import SimpleNamespace
+    import cv2
+    import numpy as np
+    import psutil
+    from core.recognizer import FaceRecognizer
+    from core.person_detector import PersonDetector
+    from core.trainer import ViolationTrainer
+    from core.uniform_matcher import UniformColorMatcher
+    from core.performance import PERF
+    PERF.enabled = True
+
+    # Match dashboard OpenCV policy for both conditions, before any inference.
+    cv2.setNumThreads(2)
+    recognizer = FaceRecognizer(SimpleNamespace(get_all_students=lambda: [], recognition_capture_encodings=lambda: {}))
+    detector, trainer, matcher = PersonDetector(), ViolationTrainer(), UniformColorMatcher()
+    if args.policy == "baseline":
+        registry, dashboard_start = baseline_registry(recognizer, detector, trainer, matcher, args.baseline_ref)
+        start = registry.start
+    else:
+        from core.monitor_models import MonitorModels
+        models = MonitorModels(recognizer, detector, trainer, matcher)
+        registry, start, dashboard_start = models.readiness, models.start, models.start
+    imported = time.monotonic()
+    prepared = imported
+    start()
+    ready_at = {}
+    at_login = None
+    login = None
+    while time.monotonic() - prepared < 65:
+        now = time.monotonic()
+        statuses = registry.snapshot()
+        for name, status in statuses.items():
+            if status.state == "ready":
+                ready_at.setdefault(name, now - prepared)
+        if login is None and now - prepared >= args.login_delay:
+            at_login = {name: status.state for name, status in statuses.items()}
+            login = now
+            dashboard_start()
+        if login is not None and all(s.state in ("ready", "failed") for s in registry.snapshot().values()):
+            break
+        time.sleep(.005)
+    registry.wait(2)
+    statuses = registry.snapshot()
+    # Re-read final transition before reporting; no native owner is cancelled/retried.
+    now = time.monotonic()
+    for name, status in statuses.items():
+        if status.state == "ready":
+            ready_at.setdefault(name, now-prepared)
+    stages = {"face": [], "embedding": [], "body": [], "uniform": [], "cycle": []}
+    frame = np.zeros((720, 1280, 3), np.uint8)
+    crop = np.zeros((224, 224, 3), np.uint8)
+    face_crop = np.zeros((112, 112, 3), np.uint8)
+    process = psutil.Process()
+    rss = [process.memory_info().rss]
+    cpu_start = process.cpu_times()
+    steady_start = time.monotonic()
+    counts = {"faces": 0, "bodies": 0, "cycles": 0}
+    while time.monotonic()-steady_start < args.seconds:
+        cycle = time.monotonic()
+        calls = (("face", "face", lambda: recognizer.detect_faces(frame)),
+                 ("embedding", "recognition", lambda: recognizer._ensure_recognition().get_feat(face_crop)),
+                 ("body", "body", lambda: detector.detect_persons(frame)),
+                 ("uniform", "uniform", lambda: trainer.predict_proba("uniform", crop)))
+        for name, component, call in calls:
+            if registry.ready(component):
+                at = time.monotonic()
+                result = call()
+                stages[name].append((time.monotonic()-at)*1000)
+                if name in ("face", "body"):
+                    counts["faces" if name == "face" else "bodies"] += len(result)
+        stages["cycle"].append((time.monotonic()-cycle)*1000)
+        counts["cycles"] += 1
+        rss.append(process.memory_info().rss)
+    elapsed = time.monotonic()-steady_start
+    cpu_end = process.cpu_times()
+    summary = lambda values: {"n": len(values), "p50_ms": round(float(np.percentile(values, 50)), 3),
+                              "p95_ms": round(float(np.percentile(values, 95)), 3)} if values else None
+    result = dict(policy=args.policy, baseline_ref=args.baseline_ref, process_cold=True, uncached=False,
+        synthetic_blank_pixels=True, camera=False, native_ui=False, database=False,
+        environment={"python": platform.python_version(), "platform": platform.platform(),
+                     "machine": platform.machine(), "processor": platform.processor(),
+                     "packages": {name: importlib.metadata.version(name) for name in
+                                  ("numpy", "opencv-python", "onnxruntime", "torch", "ultralytics", "insightface")}},
+        setup_seconds=round(imported-started, 3), simulated_login_delay=args.login_delay,
+        states_at_login=at_login, ready_from_prepare_seconds={k: round(v, 3) for k,v in ready_at.items()},
+        remaining_after_login_seconds={k: round(max(0, v-(login-prepared)), 3) for k,v in ready_at.items()} if login else {},
+        components={k: {"state": v.state, "load_and_warm_seconds": round(v.elapsed, 3), "error": v.error} for k,v in statuses.items()},
+        steady_seconds=round(elapsed, 3), serial_probe_hz=round(counts["cycles"]/elapsed, 3),
+        stage_timings={k: summary(v) for k,v in stages.items()},
+        rss_start_mb=round(rss[0]/2**20, 2), rss_end_mb=round(rss[-1]/2**20, 2),
+        rss_peak_mb=round(max(rss)/2**20, 2), process_peak_rss_mb=round(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/2**20, 2),
+        cpu_percent_one_core=round(100*((cpu_end.user-cpu_start.user)+(cpu_end.system-cpu_start.system))/elapsed, 1),
+        blank_scene_detections=counts, accuracy_evaluated=False, bounded_timings=PERF.snapshot())
+    print("RESULT " + json.dumps(result), flush=True)
+    return 0 if all(registry.ready(name) for name in ("face", "recognition", "body", "uniform")) else 2
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--policy", choices=("baseline", "candidate"), required=True)
+    parser.add_argument("--baseline-ref", default="244d6805ee00c5f8b3bf60f9fecf0d288dc70b7c")
+    parser.add_argument("--login-delay", type=float, default=5.)
+    parser.add_argument("--seconds", type=float, default=10.)
+    parser.add_argument("--runs", type=int, default=3)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--child", action="store_true", help=argparse.SUPPRESS)
+    args = parser.parse_args()
+    if args.seconds <= 0 or args.login_delay < 0 or args.runs < 1:
+        parser.error("seconds/runs must be positive; login-delay cannot be negative")
+    if args.child:
+        return child(args)
+    results = []
+    for run in range(args.runs):
+        completed = subprocess.run([sys.executable, __file__, *sys.argv[1:], "--child"],
+                                   cwd=ROOT, text=True, capture_output=True, timeout=100+args.seconds+args.login_delay)
+        lines = [line[7:] for line in completed.stdout.splitlines() if line.startswith("RESULT ")]
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.with_suffix(f".run{run+1}.log").write_text(completed.stdout+completed.stderr)
+        if completed.returncode or not lines:
+            # Libraries can be noisy; these probes never read personal records.
+            raise RuntimeError(f"Probe failed ({completed.returncode}): {completed.stderr[-3000:]} {completed.stdout[-1000:]}")
+        result = json.loads(lines[-1])
+        results.append(result)
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(json.dumps(results, indent=2)+"\n")
+        print(json.dumps({"run": run+1, "policy": args.policy, "ready": result["remaining_after_login_seconds"],
+                          "stages": result["stage_timings"]}), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/probe_monitor_camera.py b/scripts/probe_monitor_camera.py
new file mode 100644
index 0000000..c239d35
--- /dev/null
+++ b/scripts/probe_monitor_camera.py
@@ -0,0 +1,190 @@
+"""Consented MacBook/USB camera probe with an ephemeral in-memory test identity.
+
+No database, persistence worker, alerts, image files, or embedding files. Only
+aggregate numeric measurements are written. This is not an accuracy evaluation.
+"""
+import argparse
+from collections import Counter, deque
+import json
+from pathlib import Path
+import queue
+import sys
+import threading
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+
+class ProbeRoster:
+    student = dict(student_id="SYNTHETIC-CAMERA-PROBE", name="Test participant",
+                   gender="Unspecified", student_status="Enrolled", registration_pending=False)
+    def get_all_students(self): return []
+    def recognition_capture_encodings(self): return {}
+    def attendance_term_snapshot(self, **kwargs): return {}
+    def get_student_by_student_id(self, sid): return dict(self.student) if sid == self.student["student_id"] else None
+    def enrollment_context(self, sid, **kwargs):
+        return dict(eligible=True, status="Synthetic test eligibility", enrollment={}, term={})
+    def get_active_suspension(self, sid): return None
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--consenting-participant", action="store_true", required=True)
+    parser.add_argument("--seconds", type=float, default=35.)
+    parser.add_argument("--camera-index", type=int, default=0)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if args.seconds <= 0:
+        parser.error("seconds must be positive")
+    import tkinter as tk
+    import cv2
+    import numpy as np
+    import psutil
+    from core.camera import CameraCapture
+    from core.live_pipeline import LiveProcessor, FaceTrackingProcessor, LiveWorker, MonitorTask
+    from core.live_state import FrameContext
+    from core.monitor_models import MonitorModels
+    from core.recognizer import FaceRecognizer
+    from core.person_detector import PersonDetector
+    from core.performance import PERF, measure
+    from ui.camera_feed import CameraFeed
+
+    cv2.setNumThreads(2)
+    PERF.enabled = True
+    PERF.start_monitor()
+    started = time.monotonic()
+    cancelled = threading.Event()
+    capture_done = threading.Event()
+    capture = CameraCapture(camera_index=args.camera_index, width=1280, height=720,
+                            fps_cap=30, cancel_event=cancelled)
+    captured = deque(maxlen=4096)
+    camera_first = [None]
+    def camera_loop():
+        try:
+            if not capture.open(): return
+            camera_first[0] = time.monotonic()-started
+            while not cancelled.is_set():
+                if capture.read() is not None: captured.append(time.monotonic())
+        finally:
+            capture.release()
+            capture_done.set()
+    reader = threading.Thread(target=camera_loop, daemon=True)
+    reader.start()
+    roster = ProbeRoster()
+    recognizer, detector = FaceRecognizer(roster), PersonDetector()
+    models = MonitorModels(recognizer, detector)
+    models.start()
+    calibrated = threading.Event()
+    calibration_done = threading.Event()
+    first_detection = [None]
+    calibration_at = [None]
+    def calibrate():
+        try:
+            while not cancelled.wait(.02):
+                if not (models.readiness.ready("face") and models.readiness.ready("recognition")): continue
+                sample = capture.get_latest_sample()
+                if sample is None or time.monotonic()-sample.captured_at > 1: continue
+                rows = recognizer.detect_faces(sample.frame)
+                if rows and first_detection[0] is None: first_detection[0] = time.monotonic()-started
+                if len(rows) != 1: continue
+                embeddings = recognizer._embed_detections(sample.frame, rows)
+                if not embeddings or time.monotonic()-sample.captured_at > 3: continue
+                with recognizer._lock:
+                    recognizer._known = [(dict(roster.student), np.asarray([embeddings[0][1]], np.float32))]
+                calibration_at[0] = time.monotonic()-started
+                calibrated.set()
+                return
+        finally:
+            calibration_done.set()
+    calibration = threading.Thread(target=calibrate, daemon=True)
+    calibration.start()
+    processor = LiveProcessor(roster, recognizer, detector, models.trainer, models.uniform_matcher, None)
+    processor.readiness = models.readiness
+    # No side-effect API is invoked, including unknown sightings or attendance.
+    processor.persist = lambda result: None
+    assessment = LiveWorker(processor)
+    last_offer = [0.]
+    def localized(result):
+        if result.task.context.captured_at-last_offer[0] >= .5:
+            assessment.offer(result.task.with_observations(result.observations))
+            last_offer[0] = result.task.context.captured_at
+    tracking = LiveWorker(FaceTrackingProcessor(recognizer, detector, models.readiness, localized))
+    assessment.start(); tracking.start()
+    root = tk.Tk()
+    root.title("CBVMS temporary camera check — no records or images saved")
+    root.geometry("960x650")
+    feed = CameraFeed(root); feed.pack(fill="both", expand=True)
+    status = tk.Label(root, text="Preparing models; stay centered with shoulders visible")
+    status.pack(fill="x")
+    root.protocol("WM_DELETE_WINDOW", cancelled.set)
+    last_frame = None
+    offered = None
+    next_offer = 0.
+    rendered = deque(maxlen=4096)
+    counts = dict(tracking=0, assessments=0, stable_identity_frames=0, valid_torso_frames=0,
+                  uniform_assessment_frames=0, identity_uncertain_frames=0)
+    first = {}
+    reasons = Counter()
+    resolution = None
+    process = psutil.Process()
+    rss = []
+    try:
+        while not cancelled.is_set() and time.monotonic()-started < args.seconds:
+            now = time.monotonic()
+            root.update()
+            sample = capture.get_latest_sample()
+            if sample is not None and sample.frame_id != last_frame:
+                resolution = [sample.frame.shape[1], sample.frame.shape[0]]
+                with measure("ui_render"):
+                    feed.render(cv2.flip(sample.frame, 1))
+                rendered.append(time.monotonic())
+                PERF.observe("preview_age", time.monotonic()-sample.captured_at)
+                last_frame = sample.frame_id
+            if calibrated.is_set() and sample is not None and now >= next_offer and sample.frame_id != offered:
+                task = MonitorTask(FrameContext(1, sample.frame_id, sample.captured_at), sample.frame,
+                                   sample.captured_wall_time or time.time(), cancelled, earring_enabled=False)
+                tracking.offer(task)
+                offered, next_offer = sample.frame_id, now+.1
+            for kind, worker in (("tracking", tracking), ("assessments", assessment)):
+                try: result = worker.results.get_nowait()
+                except queue.Empty: continue
+                counts[kind] += 1
+                if kind == "tracking": continue
+                items = result.assessments
+                reasons.update(a.reason for a in items)
+                flags = {"stable_identity": any(a.reliable_identity for a in items),
+                         "valid_torso": any(a.torso_box for a in items),
+                         "uniform_assessment": any(a.uniform_label for a in items),
+                         "identity_uncertain": any(not a.reliable_identity for a in items)}
+                for name, present in flags.items():
+                    if present:
+                        counts[name+"_frames"] += 1
+                        first.setdefault(name, round(time.monotonic()-started, 3))
+                status.configure(text=" · ".join(dict.fromkeys(a.state for a in items)) or result.detail)
+            rss.append(process.memory_info().rss/2**20)
+            time.sleep(.01)
+    finally:
+        cancelled.set(); tracking.stop(); assessment.stop(); models.cancel_pending()
+        tracking.done.wait(5); assessment.done.wait(5); calibration_done.wait(5); capture_done.wait(5); models.wait(5)
+        with recognizer._lock: recognizer._known = []
+        feed.cleanup(); root.destroy()
+    elapsed = time.monotonic()-started
+    rate = lambda values: round((len(values)-1)/(values[-1]-values[0]), 2) if len(values)>1 else 0.
+    report = dict(kind="consented_physical_camera_temporary_identity", elapsed_seconds=round(elapsed, 3),
+        camera_first_frame_seconds=camera_first[0], first_face_seconds=first_detection[0],
+        temporary_identity_seconds=calibration_at[0], first_results_seconds=first,
+        capture_fps=rate(captured), preview_unique_fps=rate(rendered), counts=counts,
+        resolution=resolution, assessment_reasons=dict(reasons),
+        models={k: v.state for k,v in models.readiness.snapshot().items()},
+        camera_error=capture.last_error, worker_errors=[tracking.last_error, assessment.last_error],
+        workers_stopped=tracking.done.is_set() and assessment.done.is_set() and capture_done.is_set() and calibration_done.is_set(),
+        rss_peak_mb=round(max(rss), 2) if rss else None, timings=PERF.snapshot(),
+        business_writes=0, images_saved=0, embeddings_saved=0, accuracy_evaluated=False)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps(report), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_monitor_devices.py b/tests/test_monitor_devices.py
new file mode 100644
index 0000000..0a33ad6
--- /dev/null
+++ b/tests/test_monitor_devices.py
@@ -0,0 +1,59 @@
+"""Lightweight tests for the device benchmark's report helpers."""
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "benchmark_monitor_devices.py"
+SPEC = importlib.util.spec_from_file_location("benchmark_monitor_devices", SCRIPT)
+benchmark = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(benchmark)
+
+
+class MonitorDeviceBenchmarkTests(unittest.TestCase):
+    def test_percentiles_are_compact_and_order_independent(self):
+        self.assertEqual(benchmark._percentiles([9, 1, 5]),
+                         {"n": 3, "p50_ms": 5.0, "p95_ms": 8.6})
+        self.assertIsNone(benchmark._percentiles([]))
+
+    def test_device_check_normalizes_torch_device_index(self):
+        self.assertTrue(benchmark._device_matches("mps", "mps:0"))
+        self.assertTrue(benchmark._device_matches("cpu", "cpu"))
+        self.assertFalse(benchmark._device_matches("mps", "cpu"))
+        self.assertFalse(benchmark._device_matches("cuda", None))
+
+    def test_unavailable_accelerators_are_not_replaced_by_cpu(self):
+        environment = {"torch": {"cuda_available": False, "mps_available": False}}
+        self.assertEqual(benchmark._available_devices(environment), ["cpu", "default"])
+
+    def test_default_mode_is_compared_to_observed_cpu_control(self):
+        self.assertTrue(benchmark._device_matches("cpu", "cpu:0"))
+        self.assertFalse(benchmark._device_matches("cpu", "mps:0"))
+
+    def test_embedding_comparison_reports_only_scalar_metrics(self):
+        result = benchmark._embedding_comparison([3.0, 4.0], [6.0, 8.0])
+        self.assertEqual(result, {"same_shape": True, "cosine_similarity": 1.0,
+                                  "max_abs_normalized_delta": 0.0})
+        self.assertIsNone(benchmark._embedding_comparison([0.0], [1.0])["cosine_similarity"])
+
+    def test_synchronize_waits_for_available_accelerators(self):
+        calls = []
+        torch = SimpleNamespace(
+            cuda=SimpleNamespace(is_available=lambda: True,
+                                 synchronize=lambda: calls.append("cuda")),
+            backends=SimpleNamespace(mps=SimpleNamespace(is_available=lambda: True)),
+            mps=SimpleNamespace(synchronize=lambda: calls.append("mps")))
+        benchmark._synchronize_accelerators(torch)
+        self.assertEqual(calls, ["cuda", "mps"])
+
+    def test_synchronization_failure_cannot_report_valid_timing(self):
+        def fail():
+            raise RuntimeError("device synchronization failed")
+        torch = SimpleNamespace(cuda=SimpleNamespace(is_available=lambda: True, synchronize=fail))
+        with self.assertRaisesRegex(RuntimeError, "synchronization failed"):
+            benchmark._synchronize_accelerators(torch)
+
+
+if __name__ == "__main__":
+    unittest.main()
